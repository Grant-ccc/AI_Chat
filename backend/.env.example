DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=umbrella
DB_USER=umbrella
DB_PASSWORD=replace-locally
MERCHANT_USERNAME=merchant
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# disabled: 仅人工；mock: 明确标记的模拟回复；deepseek: 官方真实回复
AI_WEB_MODE=disabled
AI_SIMULATION_DATE=2026-05-04
AI_WEB_MAX_CALLS=12
AI_WEB_BUDGET_CNY=1.00
# 价格快照到期后需重新核实，不自动继续付费请求
AI_PRICE_DATE=2026-10-10
# 仅后端读取，填写官方Key；不要提交本地.env
DEEPSEEK_API_KEY=
