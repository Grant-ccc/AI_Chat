DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=umbrella
DB_USER=umbrella
DB_PASSWORD=replace-locally
MERCHANT_USERNAME=merchant
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# DeepSeek official API: fill the key only in the ignored backend/.env.
# The official adapter is implemented; web mode is disabled unless explicitly enabled.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
# Persistent trial ledger enforces these limits; failures do not retry automatically.
DEEPSEEK_TEST_MAX_CALLS=7
DEEPSEEK_TEST_BUDGET_CNY=1.00

# disabled / mock / deepseek. Mock candidates are visibly labeled and make no paid calls.
AI_REVIEW_MODE=disabled
# Set true only after a separately approved web trial budget; keep false for mock testing.
AI_REVIEW_PAID_APPROVED=false
AI_SIMULATION_DATE=2026-05-04
